# Database for the API integration tests (api/tests/integration/).
# Copy to .env.test.local (git-ignored) and layer it over .env when running them:
#
#   docker compose --env-file .env --env-file .env.test.local -f docker-compose.dev.yml \
#     run --rm --build --no-deps api npm run test:integration
#
# The suite wipes this database on every run, so it refuses to start unless the name ends
# in "_test". Create it next to the dev database, owned by the same user:
#
#   createdb -O bioenergy bioenergy_org_test
#
# Only the database settings belong here; everything else still comes from .env.

# for docker to connect to host machine running postgres, use host.docker.internal
BIOENERGY_ORG_DB_HOST=host.docker.internal
BIOENERGY_ORG_DB_LOCAL_PORT=5432
BIOENERGY_ORG_DB_USER=bioenergy
BIOENERGY_ORG_DB_PASSWORD=123456
BIOENERGY_ORG_DB_NAME=bioenergy_org_test
